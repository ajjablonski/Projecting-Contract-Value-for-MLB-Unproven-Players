# =========================================================================
# 2. PLAYER DIRECTORY (built from MSDS/Valuable_Data.xlsx)
#    Used by tab 2 (5-Tool Player Targeter / financial valuation)
# =========================================================================
scouting_cols <- c("Player", "Position", "Type", "Team_ID", "team_name",
                   "Level", "Hit", "Power", "Run", "Arm", "Field",
                   "Proj_WAR", "Current_Salary", "Contract_Status",
                   "Market_Value", "Surplus_Value")

full_pool <- Valuable_Data %>%
  filter(!is.na(Player)) %>%
  mutate(
    Player = trimws(Player),
    Position = trimws(Position),
    Type = "Hitter",
    # Prospects (no MLB service time yet) are flagged "Minor League Control"
    # and have no fWAR/salary/surplus on record; everyone else is MLB.
    Level = ifelse(`Contract Status` == "Minor League Control", "MiLB", "MLB"),
    Proj_WAR = coalesce(fWAR, 0),
    Current_Salary = coalesce(`Current Salary`, 0),
    # A couple of rows use an en-dash ("-") instead of a blank cell here,
    # which forces the whole column to read in as text -- suppressWarnings
    # because that placeholder deliberately becomes NA on coercion.
    Surplus_Value = coalesce(suppressWarnings(as.numeric(`Surplus $M`)), 0) * 1e6,
    Market_Value = Current_Salary + Surplus_Value
  ) %>%
  left_join(mlb_teams, by = c("Team" = "team_name")) %>%
  rename(team_name = Team, Contract_Status = `Contract Status`) %>%
  select(Player, Position, Type, Team_ID = team_id, team_name, Level,
         Hit = `Hit Grade`, Power = `Power Grade`, Run = `Run Grade`,
         Arm = `Arm Grade`, Field = `Field Grade`, Proj_WAR,
         Current_Salary, Contract_Status, Market_Value, Surplus_Value)

ui_team_choices <- if (nrow(full_pool) > 0) sort(unique(full_pool$team_name)) else character(0)

# Level choices ordered MLB -> AAA -> AA -> A+ -> A -> ROK -> anything else,
# so the dropdown reads top-down like an org chart instead of alphabetically.
level_order <- c("MLB", "AAA", "AA", "A+", "A", "ROK", "MiLB")
ui_level_choices <- if (nrow(full_pool) > 0) {
  present <- unique(full_pool$Level)
  c("All Levels", present[order(match(present, level_order), present)])
} else {
  c("All Levels")
}

